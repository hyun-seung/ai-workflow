{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Workflow execution record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "task_id", "parent_task_id", "task_type", "role", "adapter", "runtime_version", "requested", "observed", "timeout_seconds", "started_at", "finished_at", "duration_ms", "execution_status", "exit_code", "failure_reason", "task_verification", "result_refs", "usage"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "run_id": {"type": "string", "format": "uuid"},
    "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "parent_task_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"},
    "task_type": {"enum": [null, "development", "research", "design-review", "writing"]},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "adapter": {"const": "codex"},
    "runtime_version": {"type": ["string", "null"]},
    "requested": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "effort", "sandbox"],
      "properties": {
        "model": {"type": "string"},
        "effort": {"enum": ["low", "medium", "high", "xhigh", "max"]},
        "sandbox": {"enum": ["read-only", "workspace-write"]}
      }
    },
    "observed": {
      "description": "The adapter cannot verify actual model/effort; requested values are not observations.",
      "type": "object", "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {"model": {"type": ["string", "null"]}, "effort": {"type": ["string", "null"]}}
    },
    "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "duration_ms": {"$ref": "#/$defs/count"},
    "execution_status": {"enum": ["running", "succeeded", "failed", "interrupted", "timed_out"]},
    "exit_code": {"type": ["integer", "null"]},
    "failure_reason": {"enum": [null, "process_exit", "input_write_failed", "missing_success_event", "sigint", "sigterm", "timeout", "runner_io_error", "launch_failed"]},
    "task_verification": {"const": "not_evaluated"},
    "result_refs": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 2048}},
    "diagnostics": {
      "description": "Optional for older records. Character and completed-item counts are not token or model-call counts; no source content is stored.",
      "type": "object", "additionalProperties": false,
      "required": ["prompt", "events"],
      "properties": {
        "prompt": {
          "type": ["object", "null"], "additionalProperties": false,
          "required": ["prompt_characters", "instruction_files", "instruction_characters", "task_characters", "inline_context_sources", "inline_context_characters"],
          "properties": {
            "prompt_characters": {"$ref": "#/$defs/observed_count"},
            "instruction_files": {"$ref": "#/$defs/observed_count"},
            "instruction_characters": {"$ref": "#/$defs/observed_count"},
            "task_characters": {"$ref": "#/$defs/observed_count"},
            "inline_context_sources": {"$ref": "#/$defs/observed_count"},
            "inline_context_characters": {"$ref": "#/$defs/observed_count"}
          }
        },
        "events": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "completed_items", "completed_tool_items", "items_without_id", "model_calls"],
          "properties": {
            "status": {"enum": ["not_started", "observed", "partial"]},
            "completed_items": {
              "type": "object", "additionalProperties": false,
              "required": ["command_execution", "mcp_tool_call", "web_search", "file_change", "agent_message", "reasoning", "plan", "other"],
              "properties": {
                "command_execution": {"$ref": "#/$defs/observed_count"},
                "mcp_tool_call": {"$ref": "#/$defs/observed_count"},
                "web_search": {"$ref": "#/$defs/observed_count"},
                "file_change": {"$ref": "#/$defs/observed_count"},
                "agent_message": {"$ref": "#/$defs/observed_count"},
                "reasoning": {"$ref": "#/$defs/observed_count"},
                "plan": {"$ref": "#/$defs/observed_count"},
                "other": {"$ref": "#/$defs/observed_count"}
              }
            },
            "completed_tool_items": {"$ref": "#/$defs/observed_count"},
            "items_without_id": {"$ref": "#/$defs/observed_count"},
            "model_calls": {"const": null}
          }
        }
      }
    },
    "usage": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "source", "scope", "input_tokens", "output_tokens", "cached_input_tokens", "reasoning_output_tokens", "total_tokens", "issues"],
      "properties": {
        "status": {"enum": ["measured", "partial", "unavailable"]},
        "source": {"const": "codex.exec.json.turn.completed"},
        "scope": {"enum": ["single_turn", "last_reported_turn", "unknown"]},
        "input_tokens": {"$ref": "#/$defs/count"},
        "output_tokens": {"$ref": "#/$defs/count"},
        "cached_input_tokens": {"$ref": "#/$defs/count"},
        "reasoning_output_tokens": {"$ref": "#/$defs/count"},
        "total_tokens": {"$ref": "#/$defs/count"},
        "issues": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "count": {"type": ["integer", "null"], "minimum": 0},
    "observed_count": {"type": "integer", "minimum": 0}
  }
}
