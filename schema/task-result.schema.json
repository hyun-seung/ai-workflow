{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model task result v1 (design; runtime not implemented)",
  "description": "Standalone Codex prototype design only; implementation deferred by runtime/architecture.md. Not a mandatory Orca/Paseo common protocol. Model-reported task result. Real run IDs, usage, file versions and final workflow decisions belong to the controller.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "task_id",
    "role",
    "status",
    "summary",
    "artifacts",
    "checks",
    "tests",
    "remaining",
    "usage",
    "blocker"
  ],
  "properties": {
    "version": {
      "const": 1,
      "type": "integer"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
    },
    "role": {
      "enum": [
        "backend",
        "verifier"
      ]
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "unverified"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 1
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "command_id",
          "status",
          "evidence"
        ],
        "properties": {
          "command_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "minItems": 0
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "usage": {
      "const": "unavailable"
    },
    "blocker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reason",
            "required_action"
          ],
          "properties": {
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "required_action": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          },
          "tests": {
            "items": {
              "properties": {
                "status": {
                  "const": "pass"
                }
              }
            }
          },
          "remaining": {
            "maxItems": 0
          },
          "blocker": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "blocker": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reason",
              "required_action"
            ],
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "required_action": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "blocker": {
            "type": "null"
          }
        }
      }
    }
  ]
}
