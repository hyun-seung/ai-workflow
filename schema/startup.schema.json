{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Native environment startup configuration v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "environment": {
      "enum": [
        "auto",
        "orca",
        "paseo"
      ]
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "required": []
    },
    "project_instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repositories": {
      "type": "object",
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "project_instructions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "path"
        ]
      }
    }
  },
  "required": [
    "version"
  ]
}
